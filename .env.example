# Telegram API credentials from https://my.telegram.org (API development tools).
# chmod 600 .env after copying this file.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Local Telethon session file. Keep this private; it is equivalent to being logged in.
TELEGRAM_SESSION_PATH=./state/user.session

# SQLite state (filtered dialogs + local allowlist).
TELEGRAM_STATE_PATH=./state/filter.sqlite

# Optional. Defaults to ~/Library/Logs/telegram-spam-filter
# TELEGRAM_LOG_DIR=

# Optional tuning (seconds)
# TELEGRAM_CONTACTS_REFRESH_SECONDS=900
# TELEGRAM_REVALIDATE_SECONDS=21600
